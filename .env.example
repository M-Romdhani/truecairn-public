# Truecairn environment variables
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
#
# Regenerated from the ACTUAL env reads (apps/api/src/config.ts,
# apps/worker/src/main.ts, packages/audit/src/keys.ts). In production the
# process REFUSES TO START if a durable secret below is missing — dev/test
# generate ephemeral values with a stderr warning instead.

# ─── Database ─────────────────────────────────────────────────
# Postgres connection string (API + worker + migrations).
DATABASE_URL=postgresql://truecairn:truecairn@localhost:5432/truecairn_dev

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Behind a reverse proxy / PaaS edge that rewrites X-Forwarded-* (Railway,
# a load balancer): 'true'. Leave unset for direct/dev exposure.
# NOTE: this affects Fastify's own request.ip and https detection. It does NOT
# decide the address the per-IP throttles use — that is CLIENT_IP_HEADER below.
TRUST_PROXY=
# ── Who is the client? (QA 2026-08-26 F1) ────────────────────────────────────
# The header the trusted edge writes with the real client address. Every per-IP
# control keys on it: login, passkey and step-up TOTP throttles, the AI rate
# ceilings, and the sustained-abuse signal.
#   Cloudflare → cf-connecting-ip     (overwritten by CF on every request)
#   unset      → the socket peer, which behind an edge is ONE shared bucket:
#                still fail-closed, but no longer per-client. The API logs a
#                warning at boot when TRUST_PROXY is on and this is unset.
# X-Forwarded-For is deliberately never consulted — its leftmost entry is
# supplied by the client, which was the F1 defect. See apps/api/src/auth/client-ip.ts.
CLIENT_IP_HEADER=
# The other half of F1, and the reason CLIENT_IP_HEADER can be believed: a shared
# secret the edge injects on every request as `x-truecairn-origin-guard`.
# Set ⇒ requests without it are refused 403 before routing, so nobody can reach
# the origin directly and hand us whatever CLIENT_IP_HEADER they like.
# /health and /ready stay exempt — the platform healthcheck reaches the container
# directly, and guarding it would restart the API AND the release worker in a loop.
# ORDER MATTERS: create the Cloudflare Transform Rule that adds the header FIRST,
# confirm real traffic carries it, and only then set this. Setting it first locks
# out every visitor.
ORIGIN_GUARD_SECRET=
# Built-SPA directory for single-origin serving. A RELATIVE value is resolved
# against the working directory first — which is apps/api under the production
# `pnpm --filter @truecairn/api start`, so `../web/dist` works — and then against
# the repo root, so `apps/web/dist` works too. Neither ⇒ the API throws at boot
# naming both paths it tried. An absolute path avoids the question. Unset in dev
# — vite serves the frontend.
WEB_DIST_DIR=

# ─── Durable server secrets (REQUIRED in production) ──────────
# Server audit-log signing key (Ed25519 private key, base64 PKCS#8). Dev boots
# print a generated value — copy it here so audit signatures stay verifiable
# across restarts. The API and worker MUST share one key (they write ONE chain).
SERVER_AUDIT_SIGNING_KEY=

# KEK wrapping TOTP secrets at rest (32 bytes, base64).
# Generate: openssl rand -base64 32
TOTP_KEK=
# Prior KEK during a rotation (optional; re-wrap happens in the background).
TOTP_KEK_PREVIOUS=

# KEK wrapping the per-tier OUTER-LAYER keys at rest (32 bytes, base64). The
# worker MUST share the same value as the API.
# Generate: openssl rand -base64 32
OUTER_LAYER_KEK=
OUTER_LAYER_KEK_PREVIOUS=
# Where the outer-layer KEK LIVES. Unset (default) = env-backed, i.e. the value
# above. Set to `gcp-kms` to hold it in a Cloud KMS HSM instead: wrap/unwrap
# become KMS calls, no raw KEK ever enters process memory, and OUTER_LAYER_KEK
# is then NOT required (the KMS key + ADC are the secret). docs/18 §outer-layer.
# The API and worker must agree — a split brain here cannot unwrap what the
# other wrapped.
OUTER_LAYER_KEK_PROVIDER=
# REQUIRED when OUTER_LAYER_KEK_PROVIDER=gcp-kms (boot throws without it): the
# full Cloud KMS cryptoKey resource name,
# projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>.
OUTER_LAYER_KMS_KEY=

# Pepper for hashing client IPs in auth_attempts (>=16 bytes, base64).
# Generate: openssl rand -base64 32
IP_HASH_PEPPER=

# ─── WebAuthn relying party ───────────────────────────────────
# rpId is the registrable domain (no scheme/port); origin is the EXACT client
# origin assertions must come from. The dev defaults are localhost /
# http://localhost:3001 — production must set both (origin also drives the
# session cookie's Secure flag).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Truecairn
# Must be https:// in production — the session cookie's Secure flag is derived
# from this value's scheme, so an http:// origin there downgrades the transport.
# A production boot with a non-https value now throws rather than degrading.
WEBAUTHN_ORIGIN=http://localhost:3001
# Additional origins accepted for NATIVE app passkeys (docs/35 §3), comma-
# separated. Android sends `android:apk-key-hash:<base64url-sha256-of-cert>`
# rather than an https origin, so it can never match WEBAUTHN_ORIGIN and must be
# listed here. Additive: unset (the default) is byte-identical to pre-mobile
# behaviour. Inert on its own — the domain must ALSO serve a matching
# /.well-known/assetlinks.json, and each half fails silently without the other,
# so derive both together with `node scripts/android-passkey-identity.mjs`.
WEBAUTHN_NATIVE_ORIGINS=

# ─── Audit writer mode ────────────────────────────────────────
# 'signed' (default) writes hash-chained, Ed25519-signed entries. 'log' only
# emits "audit.deferred" log lines — local dev convenience for the WORKER.
AUDIT_MODE=signed

# ─── Worker ───────────────────────────────────────────────────
# How often the worker polls (engine ticks, sensitive-action applies, ceremony
# processing, notification deliveries) in ms.
WORKER_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=50
# Liveness ping fired after every completed loop iteration (healthchecks.io
# URL). REQUIRED in production practice: the engine that watches for the
# owner's silence needs its own watchdog. Unset ⇒ no pings (dev/test).
HEARTBEAT_URL=
# Identity for the DB-backed liveness row read by GET /health/worker
# (migration 0052). Defaults to the hostname, which is the right answer on
# Railway/containers; set explicitly only when running several workers whose
# hostnames collide. The DB heartbeat is ALWAYS on — it is the floor beneath
# HEARTBEAT_URL, so a deployment that never configured an external monitor
# still cannot end up with no watchdog on its release driver.
WORKER_ID=
# How often the worker verifies audit chains (ms, default 1h; 0 disables).
# Bounded and round-robin: a rotation cadence, not a full scan. A chain that
# fails to verify is logged at ERROR as worker.audit_chain_broken — alert on it.
AUDIT_VERIFY_INTERVAL_MS=3600000

# ─── Operations centre (/admin/system) ───────────────────────────────────────
# Comma-separated account emails allowed to read GET /v1/ops/system. UNSET ⇒ the
# routes are never registered at all (not 403 — absent), so a deployment that
# does not use the dashboard has no dashboard to attack. Grants read-only
# aggregate health; there is no write, no user lookup and no impersonation on
# that surface, and it exposes no user data by construction.
OPS_ADMIN_EMAILS=

# The date of the last VERIFIED RESTORE — an ISO day (2026-08-10) or a full
# timestamp — set by the operator from a completed restore drill (docs/23 §Restore
# drill log; docs/29 is the separate ceremony drill and does not set this). It is
# deliberately a date and not a boolean: "backups are on" is a claim this
# application cannot check and would never expire, while "a restore completed on
# this date" is checkable against a drill record and goes stale on its own. The
# `backups` tile reports it on /admin/system and (as a state only) on the public
# /status page: green while fresh, amber once the quarterly drill is overdue,
# grey when unset. Snapshots themselves are platform-managed and not observable
# from here — this never claims otherwise. A future or unparseable date is
# treated as no attestation at all, never as verified.
BACKUPS_LAST_VERIFIED_RESTORE=

# ─── Release-ceremony windows (config-driven; CI compresses these) ────────────
# Affirmation-collection deadline + per-affirmation revocation window (ms).
# The revocation window is a PUBLIC 48h promise: in production the API + worker
# REFUSE to start with a value under 1h unless ALLOW_COMPRESSED_CEREMONY_WINDOWS
# is set (deliberately compressed staging/demo drills only). Dev/test/CI are
# free to compress — the CI E2E runs the revocation window at 1000 ms.
CEREMONY_SYNC_WINDOW_MS=172800000
CEREMONY_REVOCATION_WINDOW_MS=172800000
# Set to true ONLY for a deliberately compressed drill in production; otherwise
# leave unset so the sub-hour-window guard protects the revocation promise.
ALLOW_COMPRESSED_CEREMONY_WINDOWS=

# ─── Vault limits + attachments ───────────────────────────────
VAULT_MAX_ITEM_CONTENT_BYTES=262144
VAULT_MAX_ATTACHMENT_BYTES=104857600
VAULT_MAX_USER_TOTAL_BYTES=1073741824
# Attachment blob storage backend: 'local' (default) or 's3'.
ATTACHMENTS_BACKEND=local
# local backend: base directory. With ATTACHMENTS_BACKEND=local the API and worker
# must share this directory (durable volume) — which forces them into one container.
ATTACHMENTS_DIR=attachments
# s3 backend (ATTACHMENTS_BACKEND=s3): any S3-compatible store (AWS S3, Cloudflare
# R2, Backblaze B2, MinIO). Decouples the blob store from a shared disk, so the API
# and worker can run as SEPARATE services. All five are required when backend=s3.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=truecairn-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Path-style (default true; works for R2/MinIO/most). Set false for AWS virtual-hosted.
# S3_FORCE_PATH_STYLE=true

# ─── Notifications ────────────────────────────────────────────
# Email delivery (Resend). Unset ⇒ email deliveries dead-letter (dev OK).
RESEND_API_KEY=
NOTIFICATIONS_FROM=
# Secret for the provider webhook (POST /v1/notifications/webhook/:provider).
# For production Resend this is the endpoint's Svix signing secret (whsec_…)
# from the Resend dashboard; the x-truecairn-signature raw-body HMAC scheme is
# also accepted under the same value (ops/relay path). Unset ⇒ the webhook
# route is not mounted (fail closed).
NOTIFICATIONS_WEBHOOK_SECRET=

# ─── Continuity Verification (docs/26) ────────────────────────
# Both flags default false; with both off, behaviour is byte-for-byte pre-CV.
# CV_FANOUT_ENABLED (worker): repeated verification waves to every matrix-
# enabled verified channel while the owner is in check_in_pending /
# escalation_pending. Evidence only — no wave response ever acts as a check-in.
CV_FANOUT_ENABLED=false
# CV_REPORT_ENABLED (worker + api): freeze an audit-anchored Continuity Report
# onto each release ceremony at creation (worker), and expose the owner's live
# verification-status view (api).
CV_REPORT_ENABLED=false
# CV_NARRATION_ENABLED (api): AI plain-language narration of the frozen report,
# generated lazily on the recipient-gated read path (the worker makes no AI
# calls) and stored BESIDE the sealed payload. Needs the AI generator (a Gemini
# credential + AI_ENABLED); off (default) keeps responses byte-identical.
# Optional rate ceilings: AI_RATE_NARRATION_PER_USER=10 / _PER_IP=30 per window.
CV_NARRATION_ENABLED=false
# Wave spacing per channel (hours) and sweep-issued waves per channel per
# episode. The entry one-shot is wave 0 and is not counted.
# CV_ATTEMPT_SPACING_HOURS=24
# CV_MAX_ATTEMPTS_PER_CHANNEL=3
# One-time branded welcome email, sent when a user verifies their FIRST email
# channel. Default true; set false to suppress. Needs a working email provider.
WELCOME_EMAIL_ENABLED=true
# VAULT_CAPTURE_ENABLED (api): write-only vault capture from the Flutter app
# (docs/34). The phone seals a new item to the owner's X25519 capture PUBLIC key
# and can never read one back; the owner opens and files it on the web. Off
# (default) means the capture routes are not registered at all, so the API is
# byte-for-byte pre-capture. Publishing the capture key is NOT gated by this —
# it is a public value, and pre-publishing means flipping this on later strands
# nobody.
VAULT_CAPTURE_ENABLED=false
# Per-capture ceiling. Far below VAULT_MAX_ATTACHMENT_BYTES on purpose: a
# capture is ONE AEAD message, so the sending phone holds plaintext and
# ciphertext at the same time.
# VAULT_MAX_CAPTURE_BYTES=16777216

# ─── Billing (LemonSqueezy, docs/28) ──────────────────────────
# All optional — absent ⇒ the app runs free-only (no paid upgrades), never
# crashes. Prices/plans live in the LemonSqueezy dashboard, never here.
# The webhook signing secret (verifies X-Signature). Unset ⇒ the billing
# webhook route is not mounted (fail closed).
LEMONSQUEEZY_WEBHOOK_SECRET=
# Hosted checkout URLs for the Pro plan's monthly and annual variants (copy the
# "Share / buy link" from each variant in LemonSqueezy). The API appends the
# buyer's user id + email as checkout custom data.
LEMONSQUEEZY_CHECKOUT_PRO_MONTHLY=
LEMONSQUEEZY_CHECKOUT_PRO_ANNUAL=
# The store's billing page — where a subscriber CANCELS or updates a card
# (https://<your-store>.lemonsqueezy.com/billing). Checkout and /upgrade both
# promise "cancel anytime"; unset, the product offers no way to do it and the
# only route is the LemonSqueezy receipt email. Unset ⇒ /v1/billing/status
# returns customerPortalUrl null and no "Manage subscription" link renders, so
# an unconfigured deployment shows nothing rather than a dead link.
#
# Deliberately the STORE page, not the per-subscription `urls.customer_portal`
# on every webhook payload: that one is a signed link that expires, so storing
# it would hand someone a dead URL on the day they reach for it. This one is
# good forever and the customer authenticates with their own email.
LEMONSQUEEZY_CUSTOMER_PORTAL_URL=
# Accept LemonSqueezy TEST-MODE webhook events ('true' to allow). Every payload
# carries meta.test_mode; once the store is live a stray test event must not
# entitle a real account, so this defaults to OFF and a test-mode event is
# ignored and recorded as a security event.
#
# ORDERING MATTERS. The pre-launch test purchase (docs/28) is made in test mode
# against the LIVE deployment, so it needs this set — and unset again at the
# switchover. Deliberately not derived from NODE_ENV, which would refuse exactly
# that purchase. LIVE events are never gated by this: real money always
# entitles, because a silent entitlement failure after a real charge is a refund
# and an apology.
LEMONSQUEEZY_TEST_MODE=

# ─── CV channel adapters (CV-2 SMS + push, CV-3 WhatsApp) ─────
# The public origin of THIS API (scheme+host, no trailing slash). Twilio signs
# its status webhook over the exact URL it called, so verification needs this
# verbatim. Falls back to WEBAUTHN_ORIGIN (identical in the single-origin deploy).
#
# ALSO the canonical host for crawl suppression (apps/api/src/canonical-host.ts):
# a request arriving on any OTHER host — api.truecairn.app serves the same SPA —
# gets `X-Robots-Tag: noindex` and a Disallow-everything robots.txt, so the
# duplicate copy of the site does not spend crawl budget. /v1, /health, /ready
# and /.well-known/* are never touched, and it is a header, never a redirect.
# That lane reads the RAW variable, not the fallback chain above: unset or
# unparseable ⇒ no host is treated as non-canonical and nothing is suppressed.
# PUBLIC_BASE_URL=https://truecairn.example.com
# Twilio — SMS ONLY. WhatsApp moved to Meta directly (see below); keeping the
# two channels on separate vendors is deliberate, not incidental. A missing cred
# disables just that channel (its deliveries dead-letter; it can never mint a
# verified channel).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS sender (an A2P-registered number). CV-2. Requires US A2P 10DLC registration.
# TWILIO_SMS_FROM=

# WhatsApp via Meta's Cloud API, DIRECTLY — not through Twilio (CV-3). This is a
# threat-model requirement, not a vendor preference: docs/04 §4.4 says we never
# depend on one channel, and SMS + WhatsApp sharing one account, one credential
# pair and one API host made that false by correlated failure — one outage,
# suspension or leaked token took both at once. All four unset ⇒ the whatsapp
# provider is simply absent, exactly as the Twilio vars behave. Never logged.
# The numeric phone-number id from WhatsApp Manager (NOT the phone number).
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Must be a System User PERMANENT token. A token generated in the app dashboard
# expires after 24h and surfaces as a 401 on the next send — i.e. the channel
# dies silently overnight, which for a product that notifies people the moment
# they stop responding is the failure that matters most.
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# App secret — verifies X-Hub-Signature-256 on the status webhook. A DIFFERENT
# credential from the access token above, with a different lifetime.
# WHATSAPP_CLOUD_APP_SECRET=
# The token Meta echoes back in its GET subscription handshake when you register
# the webhook URL. Any high-entropy string you also paste into the Meta dashboard.
# WHATSAPP_CLOUD_VERIFY_TOKEN=
# Template names are NOT env: we choose them at creation time, so they live in
# packages/notifications/src/whatsapp-templates.ts (nine of them, approved in
# `en`) together with the CATEGORY each is registered under. Create each in the
# Meta dashboard with the body text from that file, copied verbatim — the build
# fails if it drifts from what the other channels send.
# Eight are UTILITY. truecairn_channel_verification is AUTHENTICATION (docs/26):
# Meta fixes that body, so the text in the file is Meta's wording rather than
# ours and is the one entry not derived from the other channels' copy. Its
# code-delivery mode is "Copy code" — the autofill modes require an Android
# package name and app signature hash we do not have.
# Web push (CV-2). Generate with `npx web-push generate-vapid-keys`. The public
# key is served to the SPA; both must be set for push deliveries to send.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:security@truecairn.app

# ─── AI (Gemini provider) ─────────────────────────────────────
# The AI features are ADVISORY and METADATA-ONLY (plan docs/25 §1 P2): the model
# sees only what the server already sees (counts, tiers, item titles, contact
# roles/names, engine + ceremony state) — never ciphertext, passphrases, keys, or
# shares. An absent/invalid credential simply DISABLES AI; it never blocks boot.
# Backend: 'api' (default; the Gemini API directly, one key) or 'vertex' (through
# Google Cloud). 'api' reads GEMINI_API_KEY; Vertex reads ADC
# (GOOGLE_APPLICATION_CREDENTIALS) and needs GOOGLE_CLOUD_PROJECT.
#
# The default moved to 'api' on 2026-08-25: the 3.x models are absent from Vertex
# regional endpoints (both gemini-3.7-flash and gemini-3.5-flash returned 404 from
# us-central1) and are served on `global` only, which has no data residency. USE A
# BILLING-ENABLED KEY — on a free key Google may train on the prompts.
#
# The GOOGLE_* vars below stay documented because the vertex branch is still in
# the code as the rollback path, and docs-truth.test.ts requires every env var the
# code reads to be discoverable here.
GEMINI_BACKEND=api
GEMINI_MODEL=gemini-3.7-flash
# Vertex backend:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# api backend:
GEMINI_API_KEY=

# ─── AI Guardian guardrails (plan docs/25 §4/§9) ──────────────
# Master kill switch. Default true (today's assist/briefing). Set false to make
# EVERY AI surface return the disabled response with zero model calls — the
# one-flip incident switch. The vault/engine/ceremonies are unaffected either way.
AI_ENABLED=true
# Per-phase capability flags. All default false; each flips true only once its
# phase's acceptance criteria + security checklist pass.
AI_PROPOSER_ENABLED=false
AI_AUTONOMY_ENABLED=false
AI_GUARDIAN_ENABLED=false
# Cost circuit-breaker daily token budgets. Unset ⇒ unbounded. When exceeded the
# breaker trips: advisory surfaces go 'unavailable', the guardian uses its
# deterministic template. Non-AI product flows keep working.
AI_DAILY_TOKEN_BUDGET=
AI_USER_DAILY_TOKEN_BUDGET=
# AI-route rate-limit ceilings (per rolling window; gate MODEL CALLS, not cache
# serves). Defaults shown; override only to tune.
# A value of 0 means ZERO — it hard-blocks that surface. (Before 2026-08-07 the
# parser rejected 0 and silently used the default instead, so an operator
# blocking a surface during an incident got the permissive value.)
AI_RATE_WINDOW_MS=3600000
AI_RATE_ASSIST_PER_USER=20
AI_RATE_ASSIST_PER_IP=60
AI_RATE_BRIEFING_PER_USER=30
AI_RATE_BRIEFING_PER_IP=90
AI_RATE_GUARDIAN_EXPLAIN_PER_USER=30
AI_RATE_GUARDIAN_EXPLAIN_PER_IP=90
# Continuity Report narration (CV_NARRATION_ENABLED). Generated at most once per
# report (fill-only-NULL), so these ceilings bound retry storms after failures
# rather than normal traffic.
AI_RATE_NARRATION_PER_USER=10
AI_RATE_NARRATION_PER_IP=30
# Guardian detector thresholds (Phase 3, docs/AI.md). Deterministic — these bound
# rule-based anomaly detectors that can only PAUSE a release for review. Defaults
# shown; the worker reads them (via loadGuardianConfig).
GUARDIAN_AFFIRMATION_WINDOW_MIN=5
GUARDIAN_AFFIRMATION_THRESHOLD=3
GUARDIAN_FAILED_AUTH_WINDOW_MIN=15
GUARDIAN_FAILED_AUTH_THRESHOLD=5
# At most one automatic review per this many days, unless a severity-2 (ceremony-
# time) detector fires, which bypasses the cooldown.
GUARDIAN_COOLDOWN_DAYS=7

# ─── AI credentials (Vertex AI) ───────────────────────────────
# Vertex AI authenticates via Application Default Credentials, which wants a
# service-account KEY FILE — but Railway and most PaaS inject secrets as env
# vars. Put the raw service-account JSON here (or base64 of it, which is the
# reliable carrier: PaaS variable editors corrupt values containing quotes,
# braces or newlines) and the API writes it to a private 0600 temp file at
# startup and points ADC at it. Ignored if GOOGLE_APPLICATION_CREDENTIALS is
# already set. This is GCP auth infrastructure, never a zero-knowledge secret.
# Fail-soft: malformed JSON warns once and the AI features fail-soft at call time.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Worker identity ──────────────────────────────────────────
# Stamped on worker heartbeats/ops telemetry so a stuck deploy is attributable.
# RAILWAY_GIT_COMMIT_SHA wins when the platform injects it; this is the manual
# fallback, and '0.0.0' the last resort.
WORKER_VERSION=

# ─── Recovery-drill harness (docs/29, scripts/ceremony-drill.ts) ──
# Read ONLY by the drill script, never by the API or worker. Set them for a
# drill and unset them afterwards, alongside ALLOW_COMPRESSED_CEREMONY_WINDOWS.
#
# Comma-separated emails the harness may advance down the release ladder. Unset
# or empty is a REFUSAL, not permission, and there is no "all accounts" mode:
# advancing the wrong account sends real escalation notices to a real person's
# trusted contacts.
DRILL_ACCOUNTS=
# Fourth acknowledgement, required only under NODE_ENV=production. A drill
# account should not live in production.
DRILL_ALLOW_PRODUCTION=
