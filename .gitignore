# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Build output
dist/
build/
.next/
.turbo/
out/
# Intermediate SSR bundle for the public-page prerenderer (apps/web/src/prerender.tsx).
# Build artifact only: its OUTPUT lands in dist/ and is what ships.
.prerender/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
coverage/
.nyc_output/

# Database
*.sqlite
*.sqlite-journal
*.db

# Secrets and keys (defense in depth — these should never be committed)
*.pem
*.key
*.p12
secrets/
.secrets/

# Runtime
pids/
*.pid
*.seed

# Misc
tmp/
temp/

# Third-party agent-platform droppings (pod-local cron scripts, agent memory —
# never part of the product; one auto-commit once leaked test credentials here)
.emergent/
memory/

# Playwright outputs. Never committed: the traces are large and per-run, and
# tests/e2e/.auth/state.json holds a REAL session cookie for the E2E account —
# a credential, however throwaway. `test-results/.last-run.json` reached main
# once (2026-07-31) because a stray `playwright test` from the repo root wrote
# it outside apps/web, where nothing was ignoring it.
test-results/
playwright-report/
apps/web/tests/e2e/.auth/
